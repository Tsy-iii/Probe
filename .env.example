# Development-only defaults. Keep your real .env out of version control.
DATABASE_URL=postgresql+psycopg://probe:probe_local@127.0.0.1:5433/probe
TEST_DATABASE_URL=postgresql+psycopg://probe:probe_local@127.0.0.1:5433/probe_test
APP_ENV=development
FAULT_INJECTION_ENABLED=false
FAULT_DELAY_MS=200
PROBE_PLATFORM_DATABASE_URL=postgresql+psycopg://probe:probe_local@127.0.0.1:5433/probe_platform
PLATFORM_TEST_DATABASE_URL=postgresql+psycopg://probe:probe_local@127.0.0.1:5433/probe_platform_test
PROBE_PLATFORM_WORKER_LEASE_SECONDS=6
PROBE_PLATFORM_HEARTBEAT_SECONDS=1
PROBE_PLATFORM_MAX_ATTEMPTS=2
# Local demo operations and environment checks; automated tests use isolated services.
PROBE_PLATFORM_ORDER_API_BASE_URL=http://127.0.0.1:8002
# Enable local demo product/order operations. Production mode always disables them.
PROBE_PLATFORM_DEMO_EDIT_ENABLED=true
